<Window x:Class="AcSmartFilterPlugin.Views.FilterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор данных" Height="600" Width="400"
        MinHeight="520" MinWidth="300">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Слои активного чертежа (выберите один или несколько):"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1">
            <ListBox x:Name="LayerListBox"
                     MinHeight="100"
                     ItemsSource="{Binding Layers}"
                     IsEnabled="{Binding IsLayerListEnabled}"
                     DisplayMemberPath="Name"
                     SelectionMode="Extended"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Button Grid.Row="2"
                x:Name="PickObjectButton"
                Content="Указать объект"
                Padding="12,6"
                HorizontalAlignment="Left"
                Margin="0,8,0,0"
                Command="{Binding PickObjectCommand}"
                ToolTip="Укажите объект в чертеже — его слой будет отмечен, а тип и цвет станут критериями фильтра"/>

        <GroupBox Grid.Row="3"
                  Header="Указанный объект"
                  Margin="0,10,0,0"
                  Padding="6">
            <StackPanel>
                <TextBlock x:Name="PickedObjectDescriptionText"
                           Text="{Binding PickedObjectDescription}"
                           TextWrapping="Wrap"/>
                <CheckBox x:Name="FilterByTypeCheckBox"
                          IsChecked="{Binding FilterByObjectType, Mode=TwoWay}"
                          IsEnabled="{Binding HasPickedObject}"
                          Margin="0,8,0,0"
                          ToolTip="При применении скрыть объекты другого типа в пространстве модели и на текущем листе">
                    <TextBlock Text="{Binding FilterByTypeCaption}" TextWrapping="Wrap"/>
                </CheckBox>
                <CheckBox x:Name="FilterByColorCheckBox"
                          IsChecked="{Binding FilterByObjectColor, Mode=TwoWay}"
                          IsEnabled="{Binding HasPickedObject}"
                          Margin="0,4,0,0"
                          ToolTip="При применении скрыть объекты с другим назначением цвета. «По слою» и «По блоку» сравниваются как есть, без подстановки цвета слоя">
                    <TextBlock Text="{Binding FilterByColorCaption}" TextWrapping="Wrap"/>
                </CheckBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="4"
                  Header="Текущий слой"
                  Margin="0,10,0,0"
                  Padding="6">
            <CheckBox x:Name="CurrentLayerCheckBox"
                      Content="Фильтровать по текущему слою"
                      IsChecked="{Binding UseCurrentLayer, Mode=TwoWay}"/>
        </GroupBox>

        <Button Grid.Row="5"
                x:Name="ResetButton"
                Content="Сбросить"
                Padding="12,6"
                MinWidth="96"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                Command="{Binding ResetCommand}"/>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="CancelButton"
                    Content="Отмена"
                    Padding="12,6"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button x:Name="ConfirmButton"
                    Content="Применить"
                    Padding="12,6"
                    MinWidth="96"
                    IsDefault="True"
                    Command="{Binding ApplyCommand}"/>
        </StackPanel>
    </Grid>
</Window>
